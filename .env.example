APP_ENV=development
DEBUG=true

# Downstream
USER_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8001

# Shared secret with downstream services
INTERNAL_API_SECRET=dev-internal-secret

# Firebase — path to service account JSON
FIREBASE_CREDENTIALS_PATH=

# Dev bypass: set to a non-empty value to skip Firebase verification
# Send this value as Bearer token + X-Dev-Firebase-Uid / X-Dev-Email headers
DEV_BYPASS_TOKEN=
